# ==========================================
# BacoFrontend - Git Ignore
# ==========================================

# Environment variables / API keys
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Vite cache
.vite/

# Local environment files
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system files
.DS_Store
Thumbs.db

# Temporary / backup files
*.tmp
*.temp
*.bak